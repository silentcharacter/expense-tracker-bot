rules_version = '2';

// Deny all client (web/mobile SDK and REST with end-user auth) access.
//
// The bot backend (Cloud Function) and scripts access Firestore with the
// server-side google-cloud-firestore client using the service account, which
// bypasses Security Rules entirely. The Mini App never talks to Firestore
// directly — it goes through the authenticated /api/* routes (Telegram
// initData). So no client needs rule-based access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
